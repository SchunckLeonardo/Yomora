<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
	<!-- Records and Spring collaborators intentionally retain references. -->
	<Match>
		<Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
	</Match>

	<!-- Hibernate reads this field reflectively. -->
	<Match>
		<Class name="com.yomora.social.infrastructure.persistence.FollowEntity"/>
		<Field name="status"/>
		<Bug pattern="URF_UNREAD_FIELD"/>
	</Match>
</FindBugsFilter>
